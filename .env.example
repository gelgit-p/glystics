# ---- Core (required) ----
# PostgreSQL connection string (Supabase pooler: port 6543 + ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@localhost:5432/dispatchly?schema=public"
PORT=3000
NODE_ENV=development
# Public frontend origin, no trailing slash (email confirm links are built from this)
FRONTEND_LINK=http://localhost:5173

# ---- Auth secrets (required; generate with: openssl rand -hex 32) ----
JWT_SECRET=
JWT_REFRESH_SECRET=
EMAIL_CONFIRM_SECRET=

# ---- Email (required for signup confirmation) ----
EMAIL_USER=
EMAIL_PASS=

# ---- WhatsApp / Meta ----
WHATSAPP_APP_SECRET=
WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VERSION=v21.0
WABA_ID=
FB_APP_ID=
FB_APP_SECRET=
FB_ADMIN_TOKEN=
FB_SYSTEM_USER_ID=
FB_DEFAULT_SCOPES=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=

# ---- Shipping & payments ----
SHIPBUBBLE_API_KEY=
BACHS_API_KEY=
BACHS_BASE_URL=
LOCAL_BACHS_WEBHOOK_SECRET=
CREDIT_ADMIN_API_KEY=
LOGISTICS_PLATFORM_COMMISSION_PERCENT=10
CREDIT_COST_DELIVERY=1
CREDIT_COST_WHATSAPP=1
CREDIT_LOW_BALANCE_THRESHOLD=10

# ---- Dispatchly AI (Baseten) ----
# Without BASETEN_API_KEY the AI runs in deterministic demo mode.
AI_DEMO_MODE=false
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Set BASETEN_MODEL_ID to your Meta Muse deployment for Muse, DeepSeek example below.
BASETEN_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-0731
BASETEN_TIMEOUT_MS=30000
BASETEN_MAX_RETRIES=3
BASETEN_ENABLED=true
BASETEN_REASONING_EFFORT=high
AI_DELIVERY_DETECTION_DISABLED=false

# ---- Instagram (optional) ----
IG_USERNAME=
IG_PASSWORD=
IG_PROXY_URL=
IG_AUTH_DIR=
