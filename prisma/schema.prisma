// 1. Configure the Prisma Client generator
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

// 2. Configure the PostgreSQL database connection
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. User model for authentication and profiles
model User {
  id                               String  @id @default(uuid())
  email                            String  @unique
  password                         String
  emailConfirmed                   Boolean @default(false)
  emailConfirmToken                String?
  businessName                     String
  fullName                         String
  metaUserId                       String?
  appId                            String?
  appSecret                        String?
  facebookAcceessToken             String?
  grantedScopes                    String?
  accessTokenExpiresIn             String?
  selectedWabaId                   String?
  displayPhoneNumber               String?
  selectedFacebookBusinessId       String?
  selectedFacebookBusinessName     String?
  selectedPhoneNumberQualityRating String?
  selectedPhoneNumberVerifiedName  String?
  webhookStatus                    Boolean @default(false)

  selectedPhoneNumberId String[]
  facebookConnectStatus Boolean           @default(false)
  role                  UserRole          @default(USER)
  // Per-tenant switch for Dispatchly AI inbound delivery detection (Automations tab).
  aiDeliveryDetectionEnabled Boolean     @default(true)
  // Default sender (pickup) details for deliveries. Seeded into every AI draft;
  // editable in Profile settings and per-simulation in the AI dashboard.
  senderPhone                String?
  senderAddress              String?
  senderEmail                String?
  createdAt             DateTime          @default(now())
  hashedRefresh         String?
  messageTemplates      MessageTemplate[]
  automations           Automation[]
  creditWallet          CreditWallet?
  aiConversations       AiConversation[]
  deliveryDrafts        DeliveryDraft[]
}

enum UserRole {
  USER
  SUPER_ADMIN
}

model Token {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  facebookAccessToken          String?  @map("facebook_access_token")
  facebookLongLivedAccessToken String?  @map("facebook_long_lived_access_token")
  expiresIn                    String?
  dataAccessExpirationTime     String?
  createdAt                    DateTime @default(now())

  @@map("tokens")
}

model Delivery {
  id                         String  @id @default(uuid())
  userId                     String?
  trackingId                 String
  senderName                 String
  senderPhone                String
  senderAddress              String
  senderLatitude             String?
  senderLongitude            String?
  receiverName               String
  receiverPhone              String
  receiverAddress            String
  receiverLatitude           String?
  receiverLongitude          String?
  packageName                String
  packageCategory            String
  packageWeight              String
  packageDimensions          String
  packageValue               String
  pickupDate                 String
  courier_name               String?
  courier_email              String?
  courier_phone              String?
  shipbubbleOrderId          String?
  tracking_url               String?
  package_amount             String?
  package_weight             String?
  shipping_fee               String?
  shipping_payment_type      String?
  shipping_payment_status    String?
  package_status             Json?
  checkoutSessionId          String? @unique
  checkoutUrl                String?
  paymentAmount              String?
  paymentCurrency            String?
  paymentStatus              String
  bookingStatus              String
  bookingDetails             Json?
  deliveryInsurer            String?
  deliveryCurrency           String?
  insuranceAmount            Float?
  insurance_policy_condition String?
  insure_percentage          Float?
  insurance_cost             Float?
  insuranceCode              String?
  insurerName                String?
  bookingError               String?

  deliveryStatus       String?
  deliveryType         String
  deliveryInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model MessageTemplate {
  id String @id @default(uuid())

  // Meta template ID
  metaTemplateId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  language         String
  status           String
  category         String
  previousCategory String?
  parameterFormat  String?

  // Stores HEADER, BODY, FOOTER, BUTTONS, CAROUSEL, etc.
  components Json

  disableIosAutofill          Boolean @default(false)
  isPrimaryDeviceDeliveryOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metaTemplateId])
  @@index([userId])
  @@index([name])
  @@map("message_templates")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  transactions CreditTransaction[]
  purchases    CreditPurchase[]
}

model CreditTransaction {
  id             String                @id @default(cuid())
  walletId       String
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int
  description    String
  reference      String?               @unique
  idempotencyKey String?               @unique
  metadata       Json?
  createdAt      DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
}

model CreditPackage {
  id           String   @id @default(cuid())
  name         String   @unique
  priceKobo    Int
  credits      Int
  bonusCredits Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases CreditPurchase[]
}

model CreditPurchase {
  id                   String               @id @default(cuid())
  walletId             String
  packageId            String
  amountKobo           Int
  credits              Int
  bonusCredits         Int                  @default(0)
  paymentReference     String               @unique
  checkoutSessionId    String?              @unique
  checkoutUrl          String?
  status               CreditPurchaseStatus @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  wallet  CreditWallet  @relation(fields: [walletId], references: [id])
  package CreditPackage @relation(fields: [packageId], references: [id])

  @@index([walletId, status])
}

model Automation {
  id     String @id @default(cuid())
  userId String

  // Display name
  name String

  // WHEN
  trigger      String
  triggerValue String?

  // THEN
  action         String
  actionTemplate String

  // State
  enabled Boolean @default(true)

  // Execution statistics
  totalRuns     Int       @default(0)
  lastTriggered DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, enabled])
  @@index([trigger, triggerValue])
}

model Notification {
  id                    String @id @default(uuid())
  userId                String
  recipientPhone        String
  templateName          String
  templateLanguage      String
  templateMessage       String?
  whatsappMessageId     String?          
  deliveryTrackingId    String?
  sendAt                String?
  ReadAt                String?
  status                String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


// --- Dispatchly AI (WhatsApp -> delivery agent) ---

model AiConversation {
  id            String @id @default(uuid())
  userId        String
  customerWaId  String
  phoneNumberId String
  status        String @default("OPEN")
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AiMessage[]
  drafts        DeliveryDraft[]
  @@unique([userId, phoneNumberId, customerWaId])
  @@index([userId, status])
}

model AiMessage {
  id              String @id @default(uuid())
  conversationId  String
  waMessageId     String @unique
  direction       String
  body            String?
  rawPayload      Json?
  processingState String @default("RECEIVED")
  attempts        Int @default(0)
  nextRetryAt     DateTime?
  processingError String?
  createdAt       DateTime @default(now())
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@index([processingState, nextRetryAt])
}

model DeliveryDraft {
  id              String @id @default(uuid())
  userId          String
  conversationId  String?
  status          String @default("COLLECTING")
  senderName      String?
  senderPhone     String?
  senderAddress   String?
  senderEmail     String?
  receiverName    String?
  receiverPhone   String?
  receiverAddress String?
  receiverEmail   String?
  packageName        String?
  packageDescription String?
  packageCategory    String?
  packageCategoryId  Int?
  packageWeight      String?
  packageValue       String?
  packageQuantity    Int?
  length          Float?
  width           Float?
  height          Float?
  pickupDate      String?
  deliveryType    String?
  deliveryInstructions String?
  extracted       Json?
  missingFields   String[]
  confidence      Float?
  deliveryId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  quotes          ProviderQuote[]
  approvals       Approval[]
  @@index([userId, status])
  @@index([conversationId])
}

model ProviderQuote {
  id           String @id @default(uuid())
  draftId      String
  provider     String @default("SHIPBUBBLE")
  courierId    String
  courierName  String
  serviceCode  String
  amount       Float
  currency     String
  deliveryEta  String?
  pickupEta    String?
  score        Float
  scoreReasons String[]
  requestToken String
  raw          Json?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  draft        DeliveryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@index([draftId])
}

model Approval {
  id              String @id @default(uuid())
  draftId         String
  userId          String
  decision        String
  selectedQuoteId String?
  note            String?
  idempotencyKey  String @unique
  deliveryId      String?
  createdAt       DateTime @default(now())
  draft           DeliveryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  @@index([draftId])
  @@index([userId, decision])
}

model WebhookEventLog {
  id            String   @id @default(uuid())
  userId        String?
  source        String   // WHATSAPP | SHIPBUBBLE | BACHS
  eventType     String
  direction     String   @default("INBOUND") // INBOUND webhook, SUBSCRIPTION management action
  status        String   // RECEIVED | PROCESSED | DUPLICATE | IGNORED | FAILED | VERIFIED | SUBSCRIBED | CHECKED
  externalId   String?
  phoneNumberId String?
  summary      String?
  payload      Json?
  error        String?
  createdAt    DateTime @default(now())
  @@index([userId, createdAt])
  @@index([source, createdAt])
  @@index([externalId])
}

model AiAuditEvent {
  id        String @id @default(uuid())
  userId    String?
  actorType String
  action    String
  entityType String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

enum CreditTransactionType {
  PURCHASE
  BONUS
  USAGE
  REFUND
  ADMIN_ADJUSTMENT
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}