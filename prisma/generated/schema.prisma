// 1. Configure the Prisma Client generator
generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

// 2. Configure the PostgreSQL database connection
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. User model for authentication and profiles
model User {
  id                               String  @id @default(uuid())
  email                            String  @unique
  password                         String
  emailConfirmed                   Boolean @default(false)
  emailConfirmToken                String?
  businessName                     String
  fullName                         String
  metaUserId                       String?
  appId                            String?
  appSecret                        String?
  facebookAcceessToken             String?
  grantedScopes                    String?
  accessTokenExpiresIn             String?
  selectedWabaId                   String?
  displayPhoneNumber               String?
  selectedFacebookBusinessId       String?
  selectedFacebookBusinessName     String?
  selectedPhoneNumberQualityRating String?
  selectedPhoneNumberVerifiedName  String?
  webhookStatus                    Boolean @default(false)

  selectedPhoneNumberId      String[]
  facebookConnectStatus      Boolean                @default(false)
  role                       UserRole               @default(USER)
  // Per-tenant switch for Dispatchly AI inbound delivery detection (Automations tab).
  aiDeliveryDetectionEnabled Boolean                @default(true)
  // Default sender (pickup) details for deliveries. Seeded into every AI draft;
  // editable in Profile settings and per-simulation in the AI dashboard.
  senderPhone                String?
  senderAddress              String?
  senderEmail                String?
  createdAt                  DateTime               @default(now())
  hashedRefresh              String?
  messageTemplates           MessageTemplate[]
  automations                Automation[]
  creditWallet               CreditWallet?
  sharedNetworkBusiness      SharedNetworkBusiness?
  logisticsProvider          LogisticsProvider?
  aiConversations            AiConversation[]
  deliveryDrafts             DeliveryDraft[]
}

enum UserRole {
  USER
  SUPER_ADMIN
  LOGISTICS_PROVIDER
}

model Token {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  facebookAccessToken          String?  @map("facebook_access_token")
  facebookLongLivedAccessToken String?  @map("facebook_long_lived_access_token")
  expiresIn                    String?
  dataAccessExpirationTime     String?
  createdAt                    DateTime @default(now())

  @@map("tokens")
}

model Delivery {
  id                         String  @id @default(uuid())
  userId                     String?
  trackingId                 String
  senderName                 String
  senderPhone                String
  senderAddress              String
  senderLatitude             String?
  senderLongitude            String?
  receiverName               String
  receiverPhone              String
  receiverAddress            String
  receiverLatitude           String?
  receiverLongitude          String?
  packageName                String
  packageCategory            String
  packageWeight              String
  packageDimensions          String
  packageValue               String
  pickupDate                 String
  courier_name               String?
  courier_email              String?
  courier_phone              String?
  shipbubbleOrderId          String?
  tracking_url               String?
  package_amount             String?
  package_weight             String?
  shipping_fee               String?
  shipping_payment_type      String?
  shipping_payment_status    String?
  package_status             Json?
  checkoutSessionId          String? @unique
  checkoutUrl                String?
  paymentAmount              String?
  paymentCurrency            String?
  paymentStatus              String
  bookingStatus              String
  bookingDetails             Json?
  deliveryInsurer            String?
  deliveryCurrency           String?
  insuranceAmount            Float?
  insurance_policy_condition String?
  insure_percentage          Float?
  insurance_cost             Float?
  insuranceCode              String?
  insurerName                String?
  bookingError               String?

  deliveryStatus       String?
  deliveryType         String
  deliveryInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model MessageTemplate {
  id String @id @default(uuid())

  // Meta template ID
  metaTemplateId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  language         String
  status           String
  category         String
  previousCategory String?
  parameterFormat  String?

  // Stores HEADER, BODY, FOOTER, BUTTONS, CAROUSEL, etc.
  components Json

  disableIosAutofill          Boolean @default(false)
  isPrimaryDeviceDeliveryOnly Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metaTemplateId])
  @@index([userId])
  @@index([name])
  @@map("message_templates")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions CreditTransaction[]
  purchases    CreditPurchase[]
}

model CreditTransaction {
  id             String                @id @default(cuid())
  walletId       String
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int
  description    String
  reference      String?               @unique
  idempotencyKey String?               @unique
  metadata       Json?
  createdAt      DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
}

model CreditPackage {
  id           String   @id @default(cuid())
  name         String   @unique
  priceKobo    Int
  credits      Int
  bonusCredits Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases CreditPurchase[]
}

model CreditPurchase {
  id                String               @id @default(cuid())
  walletId          String
  packageId         String
  amountKobo        Int
  credits           Int
  bonusCredits      Int                  @default(0)
  paymentReference  String               @unique
  checkoutSessionId String?              @unique
  checkoutUrl       String?
  status            CreditPurchaseStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  wallet  CreditWallet  @relation(fields: [walletId], references: [id])
  package CreditPackage @relation(fields: [packageId], references: [id])

  @@index([walletId, status])
}

model Automation {
  id     String @id @default(cuid())
  userId String

  // Display name
  name String

  // WHEN
  trigger      String
  triggerValue String?

  // THEN
  action         String
  actionTemplate String

  // State
  enabled Boolean @default(true)

  // Execution statistics
  totalRuns     Int       @default(0)
  lastTriggered DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, enabled])
  @@index([trigger, triggerValue])
}

model Notification {
  id                 String  @id @default(uuid())
  userId             String
  recipientPhone     String
  templateName       String
  templateLanguage   String
  templateMessage    String?
  whatsappMessageId  String?
  deliveryTrackingId String?
  sendAt             String?
  ReadAt             String?
  status             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Dispatchly AI (WhatsApp -> delivery agent) ---

model AiConversation {
  id            String          @id @default(uuid())
  userId        String
  customerWaId  String
  phoneNumberId String
  status        String          @default("OPEN")
  lastMessageAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      AiMessage[]
  drafts        DeliveryDraft[]

  @@unique([userId, phoneNumberId, customerWaId])
  @@index([userId, status])
}

model AiMessage {
  id              String         @id @default(uuid())
  conversationId  String
  waMessageId     String         @unique
  direction       String
  body            String?
  rawPayload      Json?
  processingState String         @default("RECEIVED")
  attempts        Int            @default(0)
  nextRetryAt     DateTime?
  processingError String?
  createdAt       DateTime       @default(now())
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([processingState, nextRetryAt])
}

model DeliveryDraft {
  id                      String          @id @default(uuid())
  userId                  String
  conversationId          String?
  status                  String          @default("COLLECTING")
  senderName              String?
  senderPhone             String?
  senderAddress           String?
  senderEmail             String?
  receiverName            String?
  receiverPhone           String?
  receiverAddress         String?
  receiverEmail           String?
  packageName             String?
  packageDescription      String?
  packageCategory         String?
  packageCategoryId       Int?
  packageWeight           String?
  packageValue            String?
  packageQuantity         Int?
  length                  Float?
  width                   Float?
  height                  Float?
  pickupDate              String?
  deliveryType            String?
  deliveryInstructions    String?
  extracted               Json?
  missingFields           String[]
  confidence              Float?
  customerSelectedQuoteId String?
  quoteOfferSentAt        DateTime?
  quoteOfferMessageId     String?
  customerSelectionAt     DateTime?
  deliveryId              String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation            AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  quotes                  ProviderQuote[]
  approvals               Approval[]

  @@index([userId, status])
  @@index([conversationId])
}

model ProviderQuote {
  id           String        @id @default(uuid())
  draftId      String
  provider     String        @default("SHIPBUBBLE")
  courierId    String
  courierName  String
  serviceCode  String
  amount       Float
  currency     String
  deliveryEta  String?
  pickupEta    String?
  score        Float
  scoreReasons String[]
  requestToken String
  raw          Json?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  draft        DeliveryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model Approval {
  id              String        @id @default(uuid())
  draftId         String
  userId          String
  decision        String
  selectedQuoteId String?
  note            String?
  idempotencyKey  String        @unique
  deliveryId      String?
  createdAt       DateTime      @default(now())
  draft           DeliveryDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([userId, decision])
}

model WebhookEventLog {
  id            String   @id @default(uuid())
  userId        String?
  source        String // WHATSAPP | SHIPBUBBLE | BACHS
  eventType     String
  direction     String   @default("INBOUND") // INBOUND webhook, SUBSCRIPTION management action
  status        String // RECEIVED | PROCESSED | DUPLICATE | IGNORED | FAILED | VERIFIED | SUBSCRIBED | CHECKED
  externalId    String?
  phoneNumberId String?
  summary       String?
  payload       Json?
  error         String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([source, createdAt])
  @@index([externalId])
}

model AiAuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  actorType  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

enum CreditTransactionType {
  PURCHASE
  BONUS
  USAGE
  REFUND
  ADMIN_ADJUSTMENT
}

enum CreditPurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// --- Dispatchly Shared Delivery Network (independent billing from CreditWallet) ---
model SharedNetworkPlan {
  id                        String                      @id @default(cuid())
  name                      String                      @unique
  slug                      String                      @unique
  description               String?
  monthlyPriceKobo          Int                         @default(0)
  annualPriceKobo           Int                         @default(0)
  monthlyDeliveryVolume     Int                         @default(0)
  reservedCapacityAllowance Int                         @default(0)
  maxActiveSlots            Int                         @default(0)
  poolingEligible           Boolean                     @default(true)
  discountPercent           Int                         @default(0)
  analyticsAccess           Boolean                     @default(false)
  aiDispatchAccess          Boolean                     @default(false)
  priorityAllocation        Boolean                     @default(false)
  maxLocations              Int                         @default(1)
  isActive                  Boolean                     @default(true)
  sortOrder                 Int                         @default(0)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  subscriptions             SharedNetworkSubscription[]
}

model SharedNetworkBusiness {
  id                    String                            @id @default(cuid())
  userId                String                            @unique
  businessName          String
  businessEmail         String
  contactPhone          String
  category              String
  pickupLocations       String[]
  operatingRegions      String[]
  expectedDailyVolume   Int                               @default(0)
  expectedWeeklyVolume  Int                               @default(0)
  preferredWindows      String[]
  status                SharedNetworkBusinessStatus       @default(ACTIVE)
  accessEnabled         Boolean                           @default(true)
  aiAutoDispatchEnabled Boolean                           @default(false)
  aiAutoReserveEnabled  Boolean                           @default(false)
  aiSpendLimitCredits   Int?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  user                  User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions         SharedNetworkSubscription[]
  reservations          SharedNetworkReservation[]
  slots                 SharedNetworkSlot[]
  poolDeliveries        SharedNetworkPoolDelivery[]
  billingTransactions   SharedNetworkBillingTransaction[]
  invoices              SharedNetworkInvoice[]
  usageRecords          SharedNetworkUsageRecord[]

  @@index([status])
}

model SharedNetworkSubscription {
  id                 String                          @id @default(cuid())
  businessId         String
  planId             String
  status             SharedNetworkSubscriptionStatus @default(PENDING_PAYMENT)
  billingCycle       SharedNetworkBillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean                         @default(false)
  paymentReference   String?                         @unique
  checkoutSessionId  String?                         @unique
  checkoutUrl        String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  business           SharedNetworkBusiness           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan               SharedNetworkPlan               @relation(fields: [planId], references: [id])
  invoices           SharedNetworkInvoice[]

  @@index([businessId, status])
}

model SharedNetworkCapacity {
  id                  String                     @id @default(cuid())
  date                DateTime
  region              String
  window              String
  vehicleType         String                     @default("BIKE")
  totalCapacity       Int
  reservedCapacity    Int                        @default(0)
  pricePerSlotCredits Int                        @default(1)
  pricePerSlotKobo    Int                        @default(0)
  cutoffAt            DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  reservations        SharedNetworkReservation[]

  @@unique([date, region, window, vehicleType])
  @@index([region, window, date])
}

model SharedNetworkReservation {
  id             String                         @id @default(cuid())
  businessId     String
  capacityId     String
  quantity       Int
  pickupLocation String
  deliveryType   String                         @default("STANDARD")
  status         SharedNetworkReservationStatus @default(CONFIRMED)
  costCredits    Int                            @default(0)
  costKobo       Int                            @default(0)
  idempotencyKey String?                        @unique
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  business       SharedNetworkBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capacity       SharedNetworkCapacity          @relation(fields: [capacityId], references: [id])
  slots          SharedNetworkSlot[]

  @@index([businessId, createdAt])
  @@index([capacityId, status])
}

model SharedNetworkSlot {
  id             String                    @id @default(cuid())
  businessId     String
  title          String
  date           DateTime
  window         String
  startTime      String?
  endTime        String?
  quantity       Int                       @default(1)
  pickupLocation String
  isRecurring    Boolean                   @default(false)
  recurrence     String?
  status         SharedNetworkSlotStatus   @default(DRAFT)
  reservationId  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  business       SharedNetworkBusiness     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservation    SharedNetworkReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([businessId, date])
}

model SharedNetworkPool {
  id                   String                      @id @default(cuid())
  name                 String
  region               String
  date                 DateTime
  window               String
  status               SharedNetworkPoolStatus     @default(OPEN)
  courierName          String?
  vehicleType          String                      @default("BIKE")
  maxDeliveries        Int                         @default(50)
  totalDeliveries      Int                         @default(0)
  estimatedSavingsKobo Int                         @default(0)
  cutoffAt             DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deliveries           SharedNetworkPoolDelivery[]

  @@index([region, window, date, status])
}

model SharedNetworkPoolDelivery {
  id                   String                @id @default(cuid())
  poolId               String
  businessId           String
  deliveryId           String?
  quantity             Int                   @default(1)
  pickupAddress        String
  destinationRegion    String
  packageWeightKg      Float?
  status               String                @default("JOINED")
  estimatedCostKobo    Int                   @default(0)
  estimatedSavingsKobo Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  pool                 SharedNetworkPool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  business             SharedNetworkBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([businessId])
  @@index([deliveryId])
}

model SharedNetworkBillingTransaction {
  id             String                       @id @default(cuid())
  businessId     String
  type           SharedNetworkBillingTxType
  amountKobo     Int
  status         SharedNetworkBillingTxStatus @default(PENDING)
  description    String
  reference      String                       @unique
  idempotencyKey String?                      @unique
  metadata       Json?
  createdAt      DateTime                     @default(now())
  business       SharedNetworkBusiness        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model SharedNetworkInvoice {
  id             String                     @id @default(cuid())
  businessId     String
  subscriptionId String?
  number         String                     @unique
  amountKobo     Int
  status         SharedNetworkInvoiceStatus @default(OPEN)
  items          Json?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  business       SharedNetworkBusiness      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription   SharedNetworkSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
}

model SharedNetworkPricingRule {
  id                     String   @id @default(cuid())
  region                 String
  window                 String
  basePriceKobo          Int      @default(0)
  pricePerSlotCredits    Int      @default(1)
  poolingDiscountPercent Int      @default(10)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([region, window])
}

model SharedNetworkUsageRecord {
  id          String                @id @default(cuid())
  businessId  String
  type        String
  quantity    Int                   @default(0)
  costCredits Int                   @default(0)
  costKobo    Int                   @default(0)
  reference   String?
  createdAt   DateTime              @default(now())
  business    SharedNetworkBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}

model SharedNetworkAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  businessId  String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
}

enum SharedNetworkBusinessStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum SharedNetworkSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SharedNetworkBillingCycle {
  MONTHLY
  ANNUAL
}

enum SharedNetworkReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SharedNetworkSlotStatus {
  DRAFT
  BOOKED
  CANCELLED
  COMPLETED
}

enum SharedNetworkPoolStatus {
  OPEN
  LOCKED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum SharedNetworkBillingTxType {
  SUBSCRIPTION
  CAPACITY
  CREDIT_PURCHASE
  DELIVERY
  REFUND
}

enum SharedNetworkBillingTxStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum SharedNetworkInvoiceStatus {
  OPEN
  PAID
  VOID
  OVERDUE
}

model SharedNetworkSetting {
  id              String   @id @default("default")
  networkEnabled  Boolean  @default(true)
  disabledMessage String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Logistics Provider marketplace (providers publish capacity; businesses reserve it) ---
// Commission is config, never hardcoded: env LOGISTICS_PLATFORM_COMMISSION_PERCENT wins,
// then this row (id="default"), then the service default.
model LogisticsProviderSetting {
  id                String   @id @default("default")
  commissionPercent Float    @default(10)
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LogisticsProvider {
  id                 String                          @id @default(cuid())
  userId             String                          @unique
  companyName        String
  registrationNumber String?
  contactName        String
  businessEmail      String
  phoneNumber        String
  businessAddress    String
  operatingRegions   String[]
  servicesOffered    String[]
  fleetSize          Int                             @default(0)
  description        String?
  verificationStatus LogisticsVerificationStatus     @default(UNVERIFIED)
  verificationNote   String?
  payoutBankName     String?
  payoutAccountName  String?
  // Only the last 4 digits are ever stored/returned; full account numbers stay with the payment provider.
  payoutAccountLast4 String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  zones              LogisticsZone[]
  capacities         LogisticsCapacity[]
  reservations       LogisticsReservation[]
  riders             LogisticsRider[]
  vehicles           LogisticsVehicle[]
  payouts            LogisticsPayout[]
  documents          LogisticsVerificationDocument[]

  @@index([verificationStatus])
}

model LogisticsVerificationDocument {
  id         String            @id @default(cuid())
  providerId String
  name       String
  url        String
  createdAt  DateTime          @default(now())
  provider   LogisticsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model LogisticsZone {
  id                     String            @id @default(cuid())
  providerId             String
  name                   String
  region                 String
  state                  String
  city                   String
  pickupLocation         String
  supportedDestinations  String[]
  restrictedLocations    String[]
  deliveryPriceKobo      Int               @default(0)
  distantSurchargeKobo   Int               @default(0)
  estimatedDeliveryHours Int               @default(24)
  minPackages            Int               @default(1)
  maxPackages            Int?
  maxWeightKg            Float?
  supportedSizes         String[]
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  provider               LogisticsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, isActive])
}

model LogisticsCapacity {
  id                  String                  @id @default(cuid())
  providerId          String
  zoneId              String?
  title               String
  region              String
  state               String
  city                String
  pickupZones         String[]
  destinationZones    String[]
  totalCapacity       Int
  reservedCapacity    Int                     @default(0)
  unit                String                  @default("PACKAGES")
  maxWeightKg         Float?
  maxDimensions       String?
  deliveryDate        DateTime
  pickupStartTime     String
  pickupEndTime       String
  deliveryTimeframe   String
  pricePerPackageKobo Int
  minReservationQty   Int                     @default(1)
  maxReservationQty   Int?
  reservationDeadline DateTime?
  cancellationPolicy  String?
  instructions        String?
  isRecurring         Boolean                 @default(false)
  recurrence          String?
  status              LogisticsCapacityStatus @default(DRAFT)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  provider            LogisticsProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reservations        LogisticsReservation[]

  @@index([providerId, status])
  @@index([status, deliveryDate])
}

model LogisticsReservation {
  id                  String                      @id @default(cuid())
  reference           String                      @unique
  providerId          String
  capacityId          String
  // Reserving business: a Dispatchly user, optionally its Shared Network business profile.
  businessUserId      String
  businessId          String?
  businessName        String
  quantity            Int
  pickupLocation      String
  destinationZone     String
  amountKobo          Int
  commissionKobo      Int                         @default(0)
  providerEarningKobo Int                         @default(0)
  paymentStatus       LogisticsPaymentStatus      @default(UNPAID)
  status              LogisticsReservationStatus  @default(PENDING)
  specialInstructions String?
  rejectReason        String?
  idempotencyKey      String?                     @unique
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  provider            LogisticsProvider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  capacity            LogisticsCapacity           @relation(fields: [capacityId], references: [id])
  shipments           LogisticsShipment[]
  events              LogisticsReservationEvent[]

  @@index([providerId, status])
  @@index([businessUserId, createdAt])
  @@index([capacityId, status])
}

model LogisticsReservationEvent {
  id            String               @id @default(cuid())
  reservationId String
  status        String
  note          String?
  actorUserId   String?
  createdAt     DateTime             @default(now())
  reservation   LogisticsReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

// A shipment fulfils (part of) a reservation. deliveryId links the existing Delivery
// record instead of duplicating sender/receiver/package data when one already exists.
model LogisticsShipment {
  id                   String                     @id @default(cuid())
  reference            String                     @unique
  reservationId        String
  providerId           String
  deliveryId           String?
  riderId              String?
  senderName           String
  receiverName         String
  receiverPhone        String
  pickupAddress        String
  deliveryAddress      String
  packageDescription   String?
  packageWeightKg      Float?
  packageDimensions    String?
  deliveryInstructions String?
  trackingReference    String?
  proofOfDeliveryUrl   String?
  deliveryNote         String?
  status               LogisticsShipmentStatus    @default(PENDING)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  reservation          LogisticsReservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  rider                LogisticsRider?            @relation(fields: [riderId], references: [id], onDelete: SetNull)
  attempts             LogisticsDeliveryAttempt[]

  @@index([providerId, status])
  @@index([reservationId])
}

model LogisticsDeliveryAttempt {
  id         String            @id @default(cuid())
  shipmentId String
  note       String
  createdAt  DateTime          @default(now())
  shipment   LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

model LogisticsRider {
  id                  String              @id @default(cuid())
  providerId          String
  name                String
  phoneNumber         String
  vehicleType         String              @default("BIKE")
  vehicleRegistration String?
  isAvailable         Boolean             @default(true)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  provider            LogisticsProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  shipments           LogisticsShipment[]

  @@index([providerId, isAvailable])
}

model LogisticsVehicle {
  id               String            @id @default(cuid())
  providerId       String
  type             String
  registration     String
  capacityPackages Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  provider         LogisticsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model LogisticsPayout {
  id         String                @id @default(cuid())
  providerId String
  amountKobo Int
  status     LogisticsPayoutStatus @default(PENDING)
  reference  String                @unique
  note       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  provider   LogisticsProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
}

enum LogisticsVerificationStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum LogisticsCapacityStatus {
  DRAFT
  PUBLISHED
  FULL
  PAUSED
  EXPIRED
  CANCELLED
}

enum LogisticsReservationStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum LogisticsPaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum LogisticsShipmentStatus {
  PENDING
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum LogisticsPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}
